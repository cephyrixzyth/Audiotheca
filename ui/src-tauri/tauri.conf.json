{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audiotheca",
  "version": "1.0.2",
  "identifier": "com.audiotheca.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audiotheca",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8787 ws://127.0.0.1:8787 http://127.0.0.1:8788 ws://127.0.0.1:8788 http://127.0.0.1:8789 ws://127.0.0.1:8789 http://127.0.0.1:8790 ws://127.0.0.1:8790 http://127.0.0.1:8791 ws://127.0.0.1:8791 http://127.0.0.1:8792 ws://127.0.0.1:8792 http://127.0.0.1:8793 ws://127.0.0.1:8793 http://127.0.0.1:8794 ws://127.0.0.1:8794 http://127.0.0.1:8795 ws://127.0.0.1:8795 http://127.0.0.1:8796 ws://127.0.0.1:8796 http://127.0.0.1:8797 ws://127.0.0.1:8797 ipc: http://localhost:5173 ws://localhost:5173 http://tauri.localhost https://tauri.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/api-server",
      "binaries/audiotheca-engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {}
}
