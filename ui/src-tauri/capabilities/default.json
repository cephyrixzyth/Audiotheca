{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default Audiotheca desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:tray:default",
    "opener:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "api-server",
          "sidecar": true,
          "args": true
        },
        {
          "name": "audiotheca-engine",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
