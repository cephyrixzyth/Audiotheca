# Unraid — copy to .env and edit paths for your array

# --- Library (LOCAL path on Unraid host, not SMB from a PC) ---
# Host path on the array:
LIBRARY_HOST_PATH=/mnt/user/infernal-data-streams/_software/_audio
# Fixed in-container mount (do not change unless you remap volumes):
LIBRARY_CONTAINER_PATH=/library

# --- App persistence ---
# Host appdata folder → container /data (reports, cache, API token, feedback)
APPDATA_PATH=/mnt/user/appdata/audiotheca

# --- Ports (change if conflicts on Unraid) ---
UI_PORT=4210
API_PORT=4211
SEARXNG_PORT=8081

# --- API ---
AUDIOTHECA_API_PORT=8787
# Optional: set a fixed token instead of auto-generated file in appdata
# AUDIOTHECA_API_TOKEN=your-long-random-token
# Allow browser token bootstrap from LAN (default: trust Docker internal network only)
# AUDIOTHECA_ALLOW_REMOTE_TOKEN_BOOTSTRAP=1

# --- Optional: SearXNG (docker compose --profile search up) ---
SEARXNG_URL=http://searxng:8080

# --- Optional: AI lookup (OpenAI-compatible endpoint) ---
# AUDIOTHECA_AI_OPENAI_API_KEY=
# AUDIOTHECA_AI_OPENAI_BASE_URL=https://api.openai.com/v1
# AUDIOTHECA_AI_OPENAI_MODEL=gpt-4o-mini

# --- Build ---
PYTHON_VERSION=3.13
