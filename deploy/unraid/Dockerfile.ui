# Audiotheca UI — nginx + Vite static build
# Web UI 1.0.12
# syntax=docker/dockerfile:1

ARG AUDIOTHECA_VERSION=1.0.12

FROM node:24-alpine AS build

WORKDIR /app/ui

COPY ui/package.json ui/package-lock.json* ./
RUN npm ci

COPY ui/ .

ARG VITE_DEFAULT_LIBRARY_ROOT=/library
ENV VITE_DEFAULT_LIBRARY_ROOT=${VITE_DEFAULT_LIBRARY_ROOT}

ARG VITE_API_TOKEN=
ENV VITE_API_TOKEN=${VITE_API_TOKEN}

RUN npm run build

FROM nginx:1.27-alpine

ARG AUDIOTHECA_VERSION=1.0.12

LABEL org.opencontainers.image.title="Audiotheca UI" \
    org.opencontainers.image.version="${AUDIOTHECA_VERSION}"

COPY deploy/unraid/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/ui/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
