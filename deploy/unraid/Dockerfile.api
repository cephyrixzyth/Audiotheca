# Audiotheca API + engine — Unraid / Docker Compose
# Web UI / API 1.0.12 · Engine 10.0.0
# syntax=docker/dockerfile:1

ARG PYTHON_VERSION=3.13
ARG AUDIOTHECA_VERSION=1.0.12
ARG ENGINE_VERSION=10.0.0
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

ARG AUDIOTHECA_VERSION=1.0.12
ARG ENGINE_VERSION=10.0.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends p7zip-full curl clamav \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY audiotheca/ audiotheca/
COPY api/ api/
COPY *.py ./
COPY tests/ tests/

LABEL org.opencontainers.image.title="Audiotheca API" \
    org.opencontainers.image.version="${AUDIOTHECA_VERSION}" \
    audiotheca.engine.version="${ENGINE_VERSION}"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    AUDIOTHECA_HOME=/data \
    AUDIOTHECA_NO_RELOAD=1 \
    AUDIOTHECA_API_HOST=0.0.0.0 \
    AUDIOTHECA_API_PORT=8787

# Do not EXPOSE 8787 — api-vpn shares Gluetun's network namespace, and Docker
# rejects "port exposing" with network_mode: service:gluetun.

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://127.0.0.1:8787/api/health || exit 1

CMD ["python", "-m", "api.server"]
