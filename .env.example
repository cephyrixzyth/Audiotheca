# Audiotheca local configuration — copy to .env and edit
# Load in PowerShell before start-ui.ps1 or python -m api.server

# Your audio library root (required for testing on another machine)
AUDIOTHECA_LIBRARY_ROOT=D:\path\to\_software\_audio

# API path allowlist (comma-separated; usually same as library root)
AUDIOTHECA_LIBRARY_ROOTS=D:\path\to\_software\_audio

# Optional: store reports/cache outside the repo
# AUDIOTHECA_HOME=C:\AudiothecaData

# API
AUDIOTHECA_API_PORT=8787
AUDIOTHECA_API_HOST=127.0.0.1
# AUDIOTHECA_API_TOKEN=your-fixed-token-here

# UI dev server (must match API port)
VITE_API_PORT=8787
VITE_DEFAULT_LIBRARY_ROOT=D:\path\to\_software\_audio

# CLI scans
# PYTHONUNBUFFERED=1

# Optional research search (docker/searxng)
# SEARXNG_URL=http://127.0.0.1:8080

# Security / orchestration (waves L–R)
# AUDIOTHECA_REQUIRE_ADMIN=1
# AUDIOTHECA_NET_PAUSE=1
# AUDIOTHECA_METRICS_HISTORY=60
